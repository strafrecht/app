# Environment variables for Strafrecht Online Docker deployment
# Copy this file to .env and customize the values for your environment

# Django Configuration
SECRET_KEY=your-very-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
SITE_URL=https://yourdomain.com

# Database Configuration
POSTGRES_DB=strafrecht
POSTGRES_USER=django
POSTGRES_PASSWORD=secure_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://django:secure_postgres_password@postgres:5432/strafrecht

# Redis Configuration
REDIS_PASSWORD=secure_redis_password
REDIS_URL=redis://:secure_redis_password@redis:6379/0
CELERY_BROKER_URL=redis://:secure_redis_password@redis:6379/0

# Email Configuration (AWS SES)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_REGION=eu-central-1
AWS_SES_BATCH_SIZE=10
AWS_SES_RATE_LIMIT=14
DEFAULT_FROM_EMAIL=webmaster@yourdomain.com
BIRDSONG_FROM_EMAIL=newsletter@yourdomain.com
SERVER_EMAIL=system@yourdomain.com

# Newsletter Backend Configuration
USE_SES_BACKEND=True
BIRDSONG_BACKEND_CLASS=birdsong.backends.ses.SESEmailBackend
BIRDSONG_FALLBACK_BACKEND=birdsong.backends.smtp.SMTPEmailBackend

# SES Monitoring (optional)
SES_ENABLE_CLOUDWATCH=True
SES_BOUNCE_TOPIC_ARN=arn:aws:sns:eu-central-1:your-account:ses-bounces-strafrecht
SES_COMPLAINT_TOPIC_ARN=arn:aws:sns:eu-central-1:your-account:ses-complaints-strafrecht

# Admin Configuration
ADMINS=Admin Name:admin@yourdomain.com,Another Admin:admin2@yourdomain.com

# Logging
LOG_LEVEL=INFO

# Port Configuration (for development)
WEB_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Development Apps (only used when DEBUG=True)
DEV_APPS=django_extensions
