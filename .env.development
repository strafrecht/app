# Development environment variables for Strafrecht Online
# This file contains safe defaults for local development

# Django Configuration
SECRET_KEY=dev-secret-key-not-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
SITE_URL=http://localhost:8000

# Database Configuration
POSTGRES_DB=strafrecht_dev
POSTGRES_USER=django_dev
POSTGRES_PASSWORD=postgres_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://django_dev:postgres_dev@postgres:5432/strafrecht_dev

# Redis Configuration
REDIS_PASSWORD=redis_dev_password
REDIS_URL=redis://:redis_dev_password@redis:6379/0
CELERY_BROKER_URL=redis://:redis_dev_password@redis:6379/0

# Email Configuration (Development - using MailHog)
DEFAULT_FROM_EMAIL=webmaster@localhost
BIRDSONG_FROM_EMAIL=newsletter@localhost
SERVER_EMAIL=system@localhost

# For development, you can use dummy AWS credentials or real ones for testing
AWS_ACCESS_KEY_ID=dummy-key-for-dev
AWS_SECRET_ACCESS_KEY=dummy-secret-for-dev
AWS_SES_REGION=eu-central-1
AWS_SES_BATCH_SIZE=5
AWS_SES_RATE_LIMIT=1

# Newsletter Backend Configuration (can be disabled for dev)
USE_SES_BACKEND=False
BIRDSONG_BACKEND_CLASS=birdsong.backends.smtp.SMTPEmailBackend
BIRDSONG_FALLBACK_BACKEND=birdsong.backends.smtp.SMTPEmailBackend

# SES Monitoring (disabled for development)
SES_ENABLE_CLOUDWATCH=False
SES_BOUNCE_TOPIC_ARN=
SES_COMPLAINT_TOPIC_ARN=

# Admin Configuration
ADMINS=Dev Admin:dev@localhost

# Logging
LOG_LEVEL=DEBUG

# Port Configuration
WEB_PORT=8000
POSTGRES_PORT=5435
REDIS_PORT=6380

# Development Apps
DEV_APPS=django_extensions
